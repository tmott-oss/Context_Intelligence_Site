# Private lead-capture destination. Receives advisory inquiries, Context Ready
# applications, and correlated assessment-started / assessment-completed events.
# See the Lead type in lib/lead.ts for the complete field contract.
LEAD_ENDPOINT=

# Optional bearer token sent only from the server to the private lead destination.
LEAD_ENDPOINT_BEARER_TOKEN=

# Optional external scheduling destination for future calendar integration.
NEXT_PUBLIC_SCHEDULING_URL=

# Canonical production site URL used by metadata and sitemap.
NEXT_PUBLIC_SITE_URL=
